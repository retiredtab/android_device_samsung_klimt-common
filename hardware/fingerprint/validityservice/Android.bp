android_app {
    name: "validityService",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,
    required: ["privapp-permissions-com.validity.fingerprint.xml"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-com.validity.fingerprint.xml",
    src: "privapp-permissions-com.validity.fingerprint.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
